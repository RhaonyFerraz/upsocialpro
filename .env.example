# UpSocial Pro - Configurações de Ambiente (Template)
# Copie este arquivo para .env para personalizar o sistema

# Número do WhatsApp oficial (com código de país e DDD)
WHATSAPP_NUMBER=5544991690878

# E-mail de Suporte
SUPPORT_EMAIL=suporte@upsocialpro.com.br

# Nome da Plataforma
SITE_NAME="UpSocial Pro"

# Dias da Garantia de Reposição Grátis
GUARANTEE_DAYS=30

# Desconto Padrão em Porcentagem
DEFAULT_DISCOUNT_PERCENT=20

# Valor Mínimo do Pedido (R$)
MIN_ORDER_VALUE=4.00

# Total de Pedidos Entregues (Para animação de contador)
TOTAL_ORDERS_DELIVERED=185400

# Habilitar Ticker Flutuante de Vendas Recentes (true/false)
ENABLE_SALES_TICKER=true

# Habilitar Calculadora de Pacotes Personalizados (true/false)
ENABLE_CUSTOM_CALCULATOR=true

# Rastreamento de Analytics & Gravação de Tela (Opcional)
MICROSOFT_CLARITY_ID=""
GOOGLE_ANALYTICS_ID=""
SENTRY_DSN=""
